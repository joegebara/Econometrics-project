library(readxl)
da=read_excel("C:/Users/Home/OneDrive/Bureau/Cours EDHEC/Econométrie/Project/stock.xlsx")
View(da)
da=data.frame(da)
summary(da) 
da[,2]=as.numeric(da[,2])
da[,3]=as.numeric(da[,3])
da[,4]=as.numeric(da[,4])
da[,5]=as.numeric(da[,5])
da[,6]=as.numeric(da[,6])
da[,7]=as.numeric(da[,7])
da[,8]=as.numeric(da[,8])
da[,9]=as.numeric(da[,9])
da[,10]=as.numeric(da[,10])
summary(da)
aapl=da[,2]
ba=da[,3]
t=da[,4]
mgm=da[,5]
amzn=da[,6]
ibm=da[,7]
tsla=da[,8]
goog=da[,9]
sp500=da[,10]
raapl=c(NA,100*diff(log(aapl)))
rba=c(NA,100*diff(log(ba)))
rt=c(NA,100*diff(log(t)))
rmgm=c(NA,100*diff(log(mgm)))
ramzn=c(NA,100*diff(log(amzn)))
ribm=c(NA,100*diff(log(ibm)))
rtsla=c(NA,100*diff(log(tsla)))
rgoog=c(NA,100*diff(log(goog)))
rsp500=c(NA,100*diff(log(sp500)))
model_aapl=lm(raapl~rsp500, data=da)
summary(model_aapl)
model_t=lm(rt~rsp500, data=da)
summary(model_t)
model_mgm=lm(rmgm~rsp500, data=da)
summary(model_mgm)
model_amzn=lm(ramzn~rsp500, data=da)
summary(model_amzn)
model_ibm=lm(ribm~rsp500, data=da)
summary(model_ibm)
model_tsla=lm(rtsla~rsp500, data=da)
summary(model_tsla)
model_goog=lm(rgoog~rsp500, data=da)
summary(model_goog)
model_ba=lm(rba~rsp500, data=da)
summary(model_ba)
 install.packages("lmtest")
library(lmtest)
coeftest(model_aapl)
coeftest(model_ba)
coeftest(model_t)
coeftest(model_mgm)
coeftest(model_amzn)
coeftest(model_ibm)
coeftest(model_tsla)
coeftest(model_goog)
install.packages("fBasics")
library(fBasics)
basicStats(raapl)
basicStats(rba)
basicStats(rt)
basicStats(rmgm)
basicStats(ramzn)
basicsStats(ribm)
basicStats(rtsla)
basicStats(rgoog)
basicStats(rsp500)
 install.packages("quantreg")
 library(quantreg)
qreg_aapl=rq(raapl~rsp500, data=da)
summary(qreg_aapl)
rq(raapl~rsp500, data=da, tau=seq(0.1,0.9,0.1))
qreg=rq(raapl~rsp500, data=da, tau=seq(0.1,0.9,0.1))
plot(summary(qreg), level=0.95)
dev.print(device=pdf,file="rqaapl.pdf")
 plot(da$Date[-1], model_aapl$residuals, type="l", xlab="Date", ylab="Residuals")
dev.print(device=pdf,file="residuals_aapl.pdf")
library(lmtest)
bptest(formula(model_aapl), data=da, studentize=F)
bptest(formula(model_aapl),data=da,studentize=T) 
dwtest(model_aapl)
library(moments)
jarque.test(model_aapl$residuals)
save.image("C:\\Users\\Home\\OneDrive\\Bureau\\Cours EDHEC\\Econométrie\\Project\\.RData")
q()
